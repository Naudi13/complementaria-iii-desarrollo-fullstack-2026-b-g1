# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Clave para firmar los JWT (HMAC-SHA256). Mínimo 32 caracteres, aleatoria.
# Generar una:  openssl rand -base64 48
JWT_KEY=

# Opcionales (tienen valor por defecto en docker-compose.yml)
JWT_ISSUER=CitasMed.Api
JWT_AUDIENCE=CitasMed.Frontend
JWT_EXPIRES_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:8088
SEED_DEMO_DATA=true
SWAGGER_ENABLED=true
