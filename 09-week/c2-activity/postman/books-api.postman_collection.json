{
  "info": {
    "name": "Books API - CORHUILA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the whole collection with the Collection Runner (requests are ordered)."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('isbn')) {",
          "  pm.collectionVariables.set('isbn', String(Date.now()).padStart(13, '9').slice(0, 13));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "isbn",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. POST - Create book (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"{{isbn}}\",\n  \"publishedYear\": 2008,\n  \"price\": 45.9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Has Location header', () => pm.response.to.have.header('Location'));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('bookId', json.id);",
              "pm.test('Body has id and title', () => { pm.expect(json.id).to.be.a('number'); pm.expect(json.title).to.eql('Clean Code'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. GET - List books (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Body is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. GET - Book by id (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books",
            "{{bookId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Same id', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('bookId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. PUT - Update book (200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books",
            "{{bookId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code - 2nd Edition\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"{{isbn}}\",\n  \"publishedYear\": 2020,\n  \"price\": 59.0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Title updated', () => pm.expect(pm.response.json().title).to.include('2nd'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. GET - Book not found (ERROR 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books",
            "999999"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', () => pm.response.to.have.status(404));",
              "pm.test('Error body is descriptive', () => { const j = pm.response.json(); pm.expect(j.status).to.eql(404); pm.expect(j.message).to.include('not found'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. POST - Invalid body (ERROR 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"author\": \"\",\n  \"isbn\": \"123\",\n  \"publishedYear\": 1200,\n  \"price\": -5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Validation details are listed', () => { const j = pm.response.json(); pm.expect(j.message).to.eql('Validation failed'); pm.expect(j.details).to.be.an('array').that.is.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. DELETE - Delete book (204)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books",
            "{{bookId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. GET - After delete (ERROR 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books",
            "{{bookId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}